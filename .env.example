APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=suakaiyoung_learning_project
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
PMS_ACTIVE_IDLE_SECONDS=300
PMS_SESSION_IDLE_SECONDS=3600
PMS_SESSION_HISTORY_DAYS=365

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_ALLOWED_MODELS=gemini-3.5-flash

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Trading signal API, moderation, realtime, and delivery
AUTO_PUBLISH_MOBILE_SIGNAL=false
SIGNAL_REALTIME_ENABLED=true
SIGNAL_DISCORD_ENABLED=true
DISCORD_SIGNAL_WEBHOOK_URL=
DISCORD_SIGNAL_TIMEOUT_SECONDS=10
SIGNAL_DISPLAY_TIMEZONE=Asia/Kuala_Lumpur
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Preserve the escaped newlines when copying a service-account private key.
FIREBASE_PRIVATE_KEY=
FIREBASE_SIGNAL_TOPIC=hc_trading_signals
FIREBASE_AUTH_TIMEOUT_SECONDS=5
SIGNAL_CREATE_ROLE_IDS=1,2,3,201,202,502,999
SIGNAL_PUBLISH_ROLE_IDS=1,2,3,201,202,502,999
SIGNAL_MANAGE_ROLE_IDS=1,2,3,502,999

# Trading blog API and realtime synchronization
TRADING_BLOG_REALTIME_ENABLED=true
TRADING_BLOG_PUBLICATION_TIMEZONE=Asia/Singapore
TRADING_BLOG_CREATE_ROLE_IDS=1,2,3
TRADING_BLOG_PUBLISH_ROLE_IDS=1,2,3
TRADING_BLOG_MANAGE_ROLE_IDS=1,2,3

# AI Market Insight: keep the credential on the backend only.
MARKET_DATA_PROVIDER=twelvedata
TWELVE_DATA_API_KEY=
MARKET_DATA_SYMBOL=XAU/USD
MARKET_DATA_MODE=MOCK
MARKET_DATA_AUTO_REFRESH=false
MARKET_DATA_HISTORY_ENABLED=true
MARKET_DATA_QUOTE_REFRESH_SECONDS=300
MARKET_DATA_REQUEST_TIMEOUT_SECONDS=10
MARKET_DATA_PUBLISH_LATENCY_SECONDS=90
MARKET_DATA_QUOTE_STALE_SECONDS=900
MARKET_DATA_ANALYSIS_STALE_MULTIPLIER=3
MARKET_DATA_SESSION_TIMEZONE=Australia/Sydney
# Enable only after confirming Twelve Data multi-user display/redistribution rights.
MARKET_DATA_DISTRIBUTION_ALLOWED=false
