    {
      "id": "Q5",
      "themeId": "CW-003",
      "order": 5,
      "type": "practical_demonstration",
      "title": {
        "en": "Practical Demonstration: CFD",
        "zh": "实践展示：评估差价合约的交易机制、成本与对手方风险"
      },
      "prompt": {
        "en": "Using a demo account, TradingView, FXReplay, MT5 demo or another approved charting platform, demonstrate evaluating cfd trading mechanics, costs and counterparty risk. Annotate the evidence, entry condition, invalidation, stop loss, take profit and risk control, then explain why the demonstration follows the written rules.",
        "zh": "使用模拟账户、TradingView、FXReplay、MT5模拟版或其他获准图表平台展示评估差价合约的交易机制、成本与对手方风险。标注证据、入场条件、失效条件、止损、止盈与风险控制，并解释该展示为何符合书面规则。"
      },
      "instructions": {
