  "questions": [
    {
      "id": "Q1",
      "themeId": "CW-009",
      "order": 1,
      "type": "theory_single_choice",
      "title": {
        "en": "Core Decision Rule for order types",
        "zh": "按明确交易意图选择市价单、限价单与停止单的核心决策规则"
      },
      "prompt": {
        "en": "Which combination of evidence is most appropriate for assessing choosing market, limit and stop orders for defined trade intent?",
        "zh": "评估按明确交易意图选择市价单、限价单与停止单时，哪种证据组合最合适？"
      },
      "instructions": {
        "en": "Select the most accurate answer.",
        "zh": "请选择最准确的答案。"
      },
      "marks": 15,
      "answerMode": "single_choice",
      "options": [
        {
          "id": "A",
          "text": {
            "en": "Treat the most recent candle as sufficient evidence and ignore the surrounding structure.",
            "zh": "将最新一根K线视为充分证据，并忽略周围结构。"
          }
        },
        {
          "id": "B",
          "text": {
            "en": "Use observable market evidence, a written decision rule and a defined invalidation when assessing choosing market, limit and stop orders for defined trade intent.",
            "zh": "评估按明确交易意图选择市价单、限价单与停止单时，使用可观察的市场证据、书面决策规则与明确的失效条件。"
          }
        },
        {
          "id": "C",
          "text": {
            "en": "Choose the interpretation that permits the largest position and shortest stop loss.",
            "zh": "选择能够使用最大仓位和最短止损的解读。"
          }
        },
        {
          "id": "D",
          "text": {
            "en": "Assume a familiar-looking pattern will repeat without defining a failure condition.",
            "zh": "假设熟悉的形态会重复，而不定义失败条件。"
          }
        }
      ],
      "requiresText": false,
      "requiresImage": false,
      "requiresChart": false,
      "minimumCharacters": 0,
      "maximumCharacters": 0,
      "minimumImages": 0,
      "maximumImages": 0,
      "allowedFileTypes": [],
      "isRequired": true,
      "status": "published",
