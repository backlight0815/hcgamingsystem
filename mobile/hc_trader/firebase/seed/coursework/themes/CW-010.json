  "questions": [
    {
      "id": "Q1",
      "themeId": "CW-010",
      "order": 1,
      "type": "theory_single_choice",
      "title": {
        "en": "Core Decision Rule for broker",
        "zh": "评估经纪商、流动性提供者与执行质量的核心决策规则"
      },
      "prompt": {
        "en": "What distinguishes professional analysis of assessing brokers, liquidity providers and execution quality from signal chasing?",
        "zh": "对评估经纪商、流动性提供者与执行质量的专业分析与追逐信号有何区别？"
      },
      "instructions": {
        "en": "Select the most accurate answer.",
        "zh": "请选择最准确的答案。"
      },
      "marks": 15,
      "answerMode": "single_choice",
      "options": [
        {
          "id": "A",
          "text": {
            "en": "Treat the most recent candle as sufficient evidence and ignore the surrounding structure.",
            "zh": "将最新一根K线视为充分证据，并忽略周围结构。"
          }
        },
        {
          "id": "B",
          "text": {
            "en": "Choose the interpretation that permits the largest position and shortest stop loss.",
            "zh": "选择能够使用最大仓位和最短止损的解读。"
          }
        },
        {
          "id": "C",
          "text": {
            "en": "Use observable market evidence, a written decision rule and a defined invalidation when assessing assessing brokers, liquidity providers and execution quality.",
            "zh": "评估评估经纪商、流动性提供者与执行质量时，使用可观察的市场证据、书面决策规则与明确的失效条件。"
          }
        },
        {
          "id": "D",
          "text": {
            "en": "Assume a familiar-looking pattern will repeat without defining a failure condition.",
            "zh": "假设熟悉的形态会重复，而不定义失败条件。"
          }
        }
      ],
      "requiresText": false,
      "requiresImage": false,
      "requiresChart": false,
