    {
      "id": "Q4",
      "themeId": "CW-014",
      "order": 4,
      "type": "self_analysis_kbat",
      "title": {
        "en": "Independent Scenario Analysis: engulfing",
        "zh": "独立情境分析：区分有效吞没形态与视觉噪音"
      },
      "prompt": {
        "en": "Analyse both a valid and an invalid interpretation of distinguishing meaningful engulfing patterns from visual noise using the assigned chart. Compare the evidence, explain the risk boundary, identify what would change your conclusion and state when no trade is preferable.",
