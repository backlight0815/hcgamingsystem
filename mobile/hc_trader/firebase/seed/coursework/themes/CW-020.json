    {
      "id": "Q4",
      "themeId": "CW-020",
      "order": 4,
      "type": "self_analysis_kbat",
      "title": {
        "en": "Independent Scenario Analysis: false breakout",
        "zh": "独立情境分析：通过拒绝与延续失败判断假突破"
      },
      "prompt": {
        "en": "Analyse both a valid and an invalid interpretation of diagnosing false breakouts through rejection and failed follow-through using the assigned chart. Compare the evidence, explain the risk boundary, identify what would change your conclusion and state when no trade is preferable.",
