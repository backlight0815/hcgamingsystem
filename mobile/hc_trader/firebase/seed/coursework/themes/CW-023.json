    {
      "id": "Q4",
      "themeId": "CW-023",
      "order": 4,
      "type": "self_analysis_kbat",
      "title": {
        "en": "Independent Scenario Analysis: body and wick",
        "zh": "独立情境分析：将K线实体与影线结合为实用决策区"
      },
      "prompt": {
        "en": "Analyse both a valid and an invalid interpretation of combining candle bodies and wicks into practical decision zones using the assigned chart. Compare the evidence, explain the risk boundary, identify what would change your conclusion and state when no trade is preferable.",
