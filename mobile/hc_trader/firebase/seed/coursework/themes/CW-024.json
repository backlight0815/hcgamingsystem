    {
      "id": "Q4",
      "themeId": "CW-024",
      "order": 4,
      "type": "self_analysis_kbat",
      "title": {
        "en": "Independent Scenario Analysis: fresh zone",
        "zh": "独立情境分析：比较新鲜区域与多次测试价位"
      },
      "prompt": {
        "en": "Analyse both a valid and an invalid interpretation of comparing fresh zones with repeatedly tested levels using the assigned chart. Compare the evidence, explain the risk boundary, identify what would change your conclusion and state when no trade is preferable.",
