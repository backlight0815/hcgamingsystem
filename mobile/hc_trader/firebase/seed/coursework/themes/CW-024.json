    {
      "id": "Q2",
      "themeId": "CW-024",
      "order": 2,
      "type": "theory_single_choice",
      "title": {
        "en": "Applying fresh zone Under Uncertainty",
        "zh": "在不确定性下应用比较新鲜区域与多次测试价位"
      },
      "prompt": {
        "en": "The market moves quickly before confirmation of comparing fresh zones with repeatedly tested levels. Which action follows a professional plan?",
        "zh": "在比较新鲜区域与多次测试价位获得确认前市场快速波动。哪项行动符合专业计划？"
      },
      "instructions": {
        "en": "Evaluate the scenario and select the response that best protects process discipline.",
        "zh": "评估情境并选择最能保护流程纪律的做法。"
      },
      "marks": 15,
      "answerMode": "single_choice",
      "options": [
        {
          "id": "A",
          "text": {
            "en": "Enter immediately so the opportunity is not missed, then decide the stop later.",
            "zh": "立即入场以免错失机会，之后再决定止损。"
          }
        },
        {
          "id": "B",
          "text": {
            "en": "Pause the decision, re-check the written rules and accept the trade only if evidence, invalidation and risk remain valid.",
            "zh": "暂停决策，重新核对书面规则，只有在证据、失效条件与风险仍然有效时才接受交易。"
          }
        },
        {
          "id": "C",
          "text": {
            "en": "Increase risk because conflicting evidence creates a larger potential reward.",
            "zh": "由于证据冲突带来更大潜在回报，因此增加风险。"
          }
        },
        {
          "id": "D",
          "text": {
            "en": "Ignore the invalidation if the most recent candle still supports the preferred direction.",
            "zh": "如果最新K线仍支持偏好方向，就忽略失效条件。"
          }
        }
      ],
