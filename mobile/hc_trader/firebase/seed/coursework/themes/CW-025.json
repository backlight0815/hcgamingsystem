    {
      "id": "Q4",
      "themeId": "CW-025",
      "order": 4,
      "type": "self_analysis_kbat",
      "title": {
        "en": "Independent Scenario Analysis: zone validation",
        "zh": "独立情境分析：通过离开、回测与语境验证关键区域"
      },
      "prompt": {
        "en": "Analyse both a valid and an invalid interpretation of validating key zones through departure, return and context using the assigned chart. Compare the evidence, explain the risk boundary, identify what would change your conclusion and state when no trade is preferable.",
        "zh": "使用指定图表分析通过离开、回测与语境验证关键区域的有效与无效解读。比较证据，解释风险边界，说明哪些变化会改变结论，并指出何时不交易更合适。"
      },
      "instructions": {
        "en": "Write an original evidence-based analysis. Do not present the response as personal financial advice.",
        "zh": "撰写原创且以证据为基础的分析。不得将回答表述为个人财务建议。"
      },
