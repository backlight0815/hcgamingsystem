    {
      "id": "Q4",
      "themeId": "CW-026",
      "order": 4,
      "type": "self_analysis_kbat",
      "title": {
        "en": "Independent Scenario Analysis: zone invalidation",
        "zh": "独立情境分析：识别支撑或阻力失效的时刻"
      },
      "prompt": {
        "en": "Analyse both a valid and an invalid interpretation of recognising when support or resistance has been invalidated using the assigned chart. Compare the evidence, explain the risk boundary, identify what would change your conclusion and state when no trade is preferable.",
