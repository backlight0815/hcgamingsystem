    {
      "id": "Q1",
      "themeId": "CW-031",
      "order": 1,
      "type": "theory_single_choice",
      "title": {
        "en": "Core Decision Rule for swing high",
        "zh": "使用一致规则标记摆动高点与低点的核心决策规则"
      },
      "prompt": {
        "en": "Which evidence most reliably shows that labelling swing highs and swing lows with consistent rules is being applied correctly?",
        "zh": "哪项证据最可靠地表明已正确应用使用一致规则标记摆动高点与低点？"
      },
      "instructions": {
        "en": "Select the most accurate answer.",
        "zh": "请选择最准确的答案。"
      },
      "marks": 15,
      "answerMode": "single_choice",
      "options": [
        {
          "id": "A",
          "text": {
            "en": "Treat the most recent candle as sufficient evidence and ignore the surrounding structure.",
            "zh": "将最新一根K线视为充分证据，并忽略周围结构。"
          }
        },
        {
          "id": "B",
          "text": {
            "en": "Choose the interpretation that permits the largest position and shortest stop loss.",
            "zh": "选择能够使用最大仓位和最短止损的解读。"
          }
        },
        {
          "id": "C",
          "text": {
            "en": "Assume a familiar-looking pattern will repeat without defining a failure condition.",
            "zh": "假设熟悉的形态会重复，而不定义失败条件。"
          }
        },
        {
          "id": "D",
          "text": {
            "en": "Use observable market evidence, a written decision rule and a defined invalidation when assessing labelling swing highs and swing lows with consistent rules.",
            "zh": "评估使用一致规则标记摆动高点与低点时，使用可观察的市场证据、书面决策规则与明确的失效条件。"
          }
        }
      ],
      "requiresText": false,
      "requiresImage": false,
      "requiresChart": false,
      "minimumCharacters": 0,
      "maximumCharacters": 0,
