    {
      "id": "Q4",
      "themeId": "CW-036",
      "order": 4,
      "type": "self_analysis_kbat",
      "title": {
        "en": "Independent Scenario Analysis: Break of Structure",
        "zh": "独立情境分析：不提前假设收盘地确认结构突破"
      },
      "prompt": {
        "en": "Analyse both a valid and an invalid interpretation of confirming break of structure without anticipating the close using the assigned chart. Compare the evidence, explain the risk boundary, identify what would change your conclusion and state when no trade is preferable.",
