    {
      "id": "Q4",
      "themeId": "CW-040",
      "order": 4,
      "type": "self_analysis_kbat",
      "title": {
        "en": "Independent Scenario Analysis: protected high",
        "zh": "独立情境分析：利用受保护高低点维护结构偏向"
      },
      "prompt": {
        "en": "Analyse both a valid and an invalid interpretation of protecting structural bias with protected highs and lows using the assigned chart. Compare the evidence, explain the risk boundary, identify what would change your conclusion and state when no trade is preferable.",
