    {
      "id": "Q4",
      "themeId": "CW-053",
      "order": 4,
      "type": "self_analysis_kbat",
      "title": {
        "en": "Independent Scenario Analysis: H1",
        "zh": "独立情境分析：在H4叙事中解读H1内部结构"
      },
      "prompt": {
        "en": "Analyse both a valid and an invalid interpretation of reading h1 internal structure within the h4 narrative using the assigned chart. Compare the evidence, explain the risk boundary, identify what would change your conclusion and state when no trade is preferable.",
