    {
      "id": "Q4",
      "themeId": "CW-058",
      "order": 4,
      "type": "self_analysis_kbat",
      "title": {
        "en": "Independent Scenario Analysis: higher timeframe",
        "zh": "独立情境分析：以明确失效条件建立高周期偏向"
      },
      "prompt": {
        "en": "Analyse both a valid and an invalid interpretation of establishing higher-timeframe bias with explicit invalidation using the assigned chart. Compare the evidence, explain the risk boundary, identify what would change your conclusion and state when no trade is preferable.",
