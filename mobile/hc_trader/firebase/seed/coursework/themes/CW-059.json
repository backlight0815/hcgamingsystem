    {
      "id": "Q4",
      "themeId": "CW-059",
      "order": 4,
      "type": "self_analysis_kbat",
      "title": {
        "en": "Independent Scenario Analysis: lower timeframe",
        "zh": "独立情境分析：在高周期区域要求低周期确认"
      },
      "prompt": {
        "en": "Analyse both a valid and an invalid interpretation of requiring lower-timeframe confirmation at higher-timeframe areas using the assigned chart. Compare the evidence, explain the risk boundary, identify what would change your conclusion and state when no trade is preferable.",
