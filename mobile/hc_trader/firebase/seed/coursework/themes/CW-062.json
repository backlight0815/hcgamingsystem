    {
      "id": "Q4",
      "themeId": "CW-062",
      "order": 4,
      "type": "self_analysis_kbat",
      "title": {
        "en": "Independent Scenario Analysis: position size",
        "zh": "独立情境分析：根据账户风险与止损距离计算仓位"
      },
      "prompt": {
        "en": "Analyse both a valid and an invalid interpretation of calculating position size from account risk and stop distance using the assigned chart. Compare the evidence, explain the risk boundary, identify what would change your conclusion and state when no trade is preferable.",
