    {
      "id": "Q4",
      "themeId": "CW-069",
      "order": 4,
      "type": "self_analysis_kbat",
      "title": {
        "en": "Independent Scenario Analysis: scaling",
        "zh": "独立情境分析：评估加仓与金字塔策略而不放大隐性风险"
      },
      "prompt": {
        "en": "Analyse both a valid and an invalid interpretation of evaluating scaling and pyramiding without multiplying hidden risk using the assigned chart. Compare the evidence, explain the risk boundary, identify what would change your conclusion and state when no trade is preferable.",
