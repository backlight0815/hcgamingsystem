    {
      "id": "Q4",
      "themeId": "CW-072",
      "order": 4,
      "type": "self_analysis_kbat",
      "title": {
        "en": "Independent Scenario Analysis: entry rules",
        "zh": "独立情境分析：制定可审核的客观入场规则"
      },
      "prompt": {
        "en": "Analyse both a valid and an invalid interpretation of writing objective entry rules that can be audited using the assigned chart. Compare the evidence, explain the risk boundary, identify what would change your conclusion and state when no trade is preferable.",
        "zh": "使用指定图表分析制定可审核的客观入场规则的有效与无效解读。比较证据，解释风险边界，说明哪些变化会改变结论，并指出何时不交易更合适。"
      },
      "instructions": {
        "en": "Write an original evidence-based analysis. Do not present the response as personal financial advice.",
        "zh": "撰写原创且以证据为基础的分析。不得将回答表述为个人财务建议。"
      },
