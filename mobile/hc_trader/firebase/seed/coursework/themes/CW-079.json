  "theme": {
    "id": "CW-079",
    "code": "CW-079",
    "title": {
      "en": "Taking Partial Profits Without Destroying Expected Value",
      "zh": "在不破坏期望值的前提下分批止盈"
    },
    "shortTitle": {
      "en": "partial profit",
      "zh": "在不破坏期望值的前提下分批止盈"
    },
    "description": {
      "en": "This coursework evaluates how a learner explains, analyses and demonstrates taking partial profits without destroying expected value using objective chart evidence, explicit invalidation and controlled risk.",
      "zh": "本课程作业评估学习者如何运用客观图表证据、明确失效条件与受控风险来解释、分析并展示在不破坏期望值的前提下分批止盈。"
    },
    "categoryId": "trade_execution",
    "categoryName": {
