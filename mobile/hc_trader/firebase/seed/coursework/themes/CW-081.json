{
  "theme": {
    "id": "CW-081",
    "code": "CW-081",
    "title": {
      "en": "Preventing FOMO with Predefined Entry and No-Trade Rules",
      "zh": "通过预设入场与禁止交易规则防止错失恐惧"
    },
    "shortTitle": {
      "en": "FOMO",
      "zh": "通过预设入场与禁止交易规则防止错失恐惧"
    },
    "description": {
      "en": "This coursework evaluates how a learner explains, analyses and demonstrates preventing fomo with predefined entry and no-trade rules using objective chart evidence, explicit invalidation and controlled risk.",
      "zh": "本课程作业评估学习者如何运用客观图表证据、明确失效条件与受控风险来解释、分析并展示通过预设入场与禁止交易规则防止错失恐惧。"
    },
    "categoryId": "trading_psychology",
    "categoryName": {
      "en": "Trading Psychology and Discipline",
      "zh": "交易心理与纪律"
    },
    "difficulty": "advanced",
    "learningObjectives": {
      "en": [
        "Explain the core decision rules behind preventing fomo with predefined entry and no-trade rules.",
        "Apply preventing fomo with predefined entry and no-trade rules to chart evidence without promising a trading outcome.",
        "Document invalidation and risk controls before demonstrating the skill."
      ],
      "zh": [
        "解释通过预设入场与禁止交易规则防止错失恐惧背后的核心决策规则。",
        "将通过预设入场与禁止交易规则防止错失恐惧应用于图表证据，同时不承诺交易结果。",
        "在展示技能前记录失效条件与风险控制。"
      ]
    },
