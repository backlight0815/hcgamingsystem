{
  "theme": {
    "id": "CW-085",
    "code": "CW-085",
    "title": {
      "en": "Containing Greed Through Planned Targets and Position Risk",
      "zh": "通过计划目标与仓位风险约束贪婪"
    },
    "shortTitle": {
      "en": "greed",
      "zh": "通过计划目标与仓位风险约束贪婪"
    },
    "description": {
      "en": "This coursework evaluates how a learner explains, analyses and demonstrates containing greed through planned targets and position risk using objective chart evidence, explicit invalidation and controlled risk.",
      "zh": "本课程作业评估学习者如何运用客观图表证据、明确失效条件与受控风险来解释、分析并展示通过计划目标与仓位风险约束贪婪。"
    },
    "categoryId": "trading_psychology",
    "categoryName": {
