  "questions": [
    {
      "id": "Q1",
      "themeId": "CW-088",
      "order": 1,
      "type": "theory_single_choice",
      "title": {
        "en": "Core Decision Rule for discipline",
        "zh": "通过可观察行为衡量交易纪律的核心决策规则"
      },
      "prompt": {
        "en": "Which method produces the most auditable conclusion about measuring trading discipline through observable behaviour?",
        "zh": "哪种方法能够对通过可观察行为衡量交易纪律得出最可审核的结论？"
      },
      "instructions": {
        "en": "Select the most accurate answer.",
        "zh": "请选择最准确的答案。"
      },
      "marks": 15,
      "answerMode": "single_choice",
      "options": [
        {
          "id": "A",
          "text": {
            "en": "Use observable market evidence, a written decision rule and a defined invalidation when assessing measuring trading discipline through observable behaviour.",
            "zh": "评估通过可观察行为衡量交易纪律时，使用可观察的市场证据、书面决策规则与明确的失效条件。"
          }
        },
        {
          "id": "B",
          "text": {
            "en": "Treat the most recent candle as sufficient evidence and ignore the surrounding structure.",
            "zh": "将最新一根K线视为充分证据，并忽略周围结构。"
          }
        },
        {
          "id": "C",
          "text": {
            "en": "Choose the interpretation that permits the largest position and shortest stop loss.",
            "zh": "选择能够使用最大仓位和最短止损的解读。"
          }
        },
        {
          "id": "D",
          "text": {
            "en": "Assume a familiar-looking pattern will repeat without defining a failure condition.",
            "zh": "假设熟悉的形态会重复，而不定义失败条件。"
          }
        }
      ],
      "requiresText": false,
      "requiresImage": false,
      "requiresChart": false,
      "minimumCharacters": 0,
      "maximumCharacters": 0,
      "minimumImages": 0,
      "maximumImages": 0,
