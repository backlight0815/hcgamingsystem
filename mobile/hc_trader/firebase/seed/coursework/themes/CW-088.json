  "theme": {
    "id": "CW-088",
    "code": "CW-088",
    "title": {
      "en": "Measuring Trading Discipline Through Observable Behaviour",
      "zh": "通过可观察行为衡量交易纪律"
    },
    "shortTitle": {
      "en": "discipline",
      "zh": "通过可观察行为衡量交易纪律"
    },
    "description": {
      "en": "This coursework evaluates how a learner explains, analyses and demonstrates measuring trading discipline through observable behaviour using objective chart evidence, explicit invalidation and controlled risk.",
      "zh": "本课程作业评估学习者如何运用客观图表证据、明确失效条件与受控风险来解释、分析并展示通过可观察行为衡量交易纪律。"
    },
    "categoryId": "trading_psychology",
