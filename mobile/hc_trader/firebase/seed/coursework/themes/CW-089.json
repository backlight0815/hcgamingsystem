{
  "theme": {
    "id": "CW-089",
    "code": "CW-089",
    "title": {
      "en": "Separating Evidence-Based Confidence from Overconfidence",
      "zh": "区分证据驱动的信心与过度自信"
    },
    "shortTitle": {
      "en": "confidence",
      "zh": "区分证据驱动的信心与过度自信"
    },
    "description": {
      "en": "This coursework evaluates how a learner explains, analyses and demonstrates separating evidence-based confidence from overconfidence using objective chart evidence, explicit invalidation and controlled risk.",
      "zh": "本课程作业评估学习者如何运用客观图表证据、明确失效条件与受控风险来解释、分析并展示区分证据驱动的信心与过度自信。"
    },
    "categoryId": "trading_psychology",
    "categoryName": {
