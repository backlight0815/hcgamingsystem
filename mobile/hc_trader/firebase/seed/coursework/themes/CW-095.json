{
  "theme": {
    "id": "CW-095",
    "code": "CW-095",
    "title": {
      "en": "Classifying Trading Mistakes by Rule, Execution and Psychology",
      "zh": "按规则、执行与心理对交易错误分类"
    },
    "shortTitle": {
      "en": "mistake classification",
      "zh": "按规则、执行与心理对交易错误分类"
    },
    "description": {
      "en": "This coursework evaluates how a learner explains, analyses and demonstrates classifying trading mistakes by rule, execution and psychology using objective chart evidence, explicit invalidation and controlled risk.",
      "zh": "本课程作业评估学习者如何运用客观图表证据、明确失效条件与受控风险来解释、分析并展示按规则、执行与心理对交易错误分类。"
    },
    "categoryId": "journal_review",
    "categoryName": {
      "en": "Trading Journal and Performance Review",
      "zh": "交易日志与绩效复盘"
    },
    "difficulty": "advanced",
    "learningObjectives": {
      "en": [
        "Explain the core decision rules behind classifying trading mistakes by rule, execution and psychology.",
        "Apply classifying trading mistakes by rule, execution and psychology to chart evidence without promising a trading outcome.",
        "Document invalidation and risk controls before demonstrating the skill."
      ],
      "zh": [
        "解释按规则、执行与心理对交易错误分类背后的核心决策规则。",
        "将按规则、执行与心理对交易错误分类应用于图表证据，同时不承诺交易结果。",
        "在展示技能前记录失效条件与风险控制。"
      ]
    },
